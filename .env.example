# Variáveis de ambiente — NFT Marketplace
# Copie este arquivo para `.env` e ajuste conforme necessário:
#   cp .env.example .env
#
# Todas as variáveis são expostas ao cliente (prefixo VITE_) e lidas em build/dev.

# Base URL do cliente Axios (src/lib/api.ts).
# Deixe vazio para manter requisições relativas (mesma origem), permitindo que o MSW intercepte.
# Ex.: https://api.exemplo.com
VITE_API_URL=

# URL do servidor Socket.IO (src/lib/socket.ts).
# Observação: atualmente não há servidor nem mock de socket na entrega.
VITE_SOCKET_URL=http://localhost:3001

# Liga/desliga o MSW (src/main.tsx).
# O MSW é ativado sempre que o valor for diferente de "false".
# Use "false" para apontar para uma API real.
VITE_ENABLE_MOCKS=true
